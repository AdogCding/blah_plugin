<!-- Plugin Configuration File: https://plugins.jetbrains.com/docs/intellij/plugin-configuration-file.html -->
<idea-plugin>
    <!-- Unique identifier of the plugin. It should be FQN, cannot be changed between the plugin versions. -->
    <id>org.gcb.blah</id>

    <!-- Public plugin name should be written in Title Case.
         Guidelines: https://plugins.jetbrains.com/docs/marketplace/best-practices-for-listing.html#plugin-name -->
    <name>Blah</name>

    <!-- A displayed Vendor name or Organization ID displayed on the Plugins Page. -->
    <vendor url="https://likeyang.site">My Blog</vendor>

    <!-- Description of the plugin displayed on the Plugin Page and IDE Plugin Manager.
         Guidelines: https://plugins.jetbrains.com/docs/marketplace/best-practices-for-listing.html#plugin-description -->
    <description><![CDATA[
        [SQL解析] 新增针对静态 SQL 文本的参数提取机制，支持 #{param} 变量的高亮与声明跳转。
        [动态SQL] 新增对 <if> 标签中 test 属性的 OGNL 表达式解析与引用绑定。
        [动态SQL] 新增对 <foreach> 标签中 collection 属性的解析支持，精准定位集合参数。
    ]]></description>

    <!-- Product and plugin compatibility requirements.
         Read more: https://plugins.jetbrains.com/docs/intellij/plugin-compatibility.html -->
    <depends>com.intellij.java</depends>
    <depends>com.intellij.modules.xml</depends>
    <depends optional="true" config-file="database-features.xml">com.intellij.database</depends>
    <resource-bundle>messages.MyMessageBundle</resource-bundle>
    <!-- Extensions defined by the plugin.
         Read more: https://plugins.jetbrains.com/docs/intellij/plugin-extension-points.html -->
    <extensions defaultExtensionNs="com.intellij">
        <psi.referenceContributor language="XML" implementation="org.gcb.blah.mybatis.syntax.MybatisReferenceContributor" />
        <projectConfigurable
                parentId="tools"
                instance="org.gcb.blah.mybatis.jump.PluginSettingsConfigurable"
                id="org.gcb.blah.mybatis.jump.PluginSettingsConfigurable"
                displayName="MyBatis Helper"/>
        <codeInsight.lineMarkerProvider language="XML" implementationClass="org.gcb.blah.mybatis.jump.MybatisSqlMarkProvider"/>
        <notificationGroup id="MyBatisPlugin.Notification" displayType="BALLOON"/>
    </extensions>
    <actions>
        <action id="org.gcb.blah.mybatis.jump.RefreshMybatisMarkerAction"
                class="org.gcb.blah.mybatis.jump.RefreshMybatisMarkerAction"
                text="Refresh MyBatis Markers"
                description="Manually triggers a re-scan of MyBatis mappers">
            <add-to-group group-id="ToolsMenu" anchor="last"/>
        </action>
    </actions>
</idea-plugin>